{
  "version": "1.0",
  "structures": {
    "left_right": {
      "name": "左右结构",
      "types": [
        {
          "id": "lr_standard",
          "name": "标准左右",
          "leftRatio": 0.5,
          "rightRatio": 0.5,
          "gap": 0.02
        },
        {
          "id": "lr_narrow_wide",
          "name": "左窄右宽",
          "leftRatio": 0.38,
          "rightRatio": 0.62,
          "gap": 0.02
        },
        {
          "id": "lr_wide_narrow",
          "name": "左宽右窄",
          "leftRatio": 0.62,
          "rightRatio": 0.38,
          "gap": 0.02
        }
      ]
    },
    "top_bottom": {
      "name": "上下结构",
      "types": [
        {
          "id": "tb_balanced",
          "name": "上下均衡",
          "topRatio": 0.5,
          "bottomRatio": 0.5,
          "gap": 0.02
        },
        {
          "id": "tb_narrow_wide",
          "name": "上窄下宽",
          "topRatio": 0.38,
          "bottomRatio": 0.62,
          "gap": 0.02
        },
        {
          "id": "tb_wide_narrow",
          "name": "上宽下窄",
          "topRatio": 0.62,
          "bottomRatio": 0.38,
          "gap": 0.02
        }
      ]
    },
    "enclosing": {
      "name": "包围结构",
      "types": [
        {
          "id": "en_full",
          "name": "全包围",
          "innerScale": 0.6,
          "innerOffset": {
            "x": 0,
            "y": 0
          }
        },
        {
          "id": "en_top",
          "name": "上包围",
          "innerScale": 0.65,
          "innerOffset": {
            "x": 0,
            "y": 0.1
          }
        },
        {
          "id": "en_side",
          "name": "侧包围",
          "innerScale": 0.65,
          "innerOffset": {
            "x": 0.1,
            "y": 0
          }
        }
      ]
    }
  },
  "interpretationStyles": {
    "classical": {
      "name": "古风雅致",
      "description": "类似古文字训诂的文学表达",
      "template": "从{comp1}从{comp2}，{meaning}之意。",
      "visual": {
        "font": "ancient",
        "color": "#2c2c2c",
        "layout": "vertical"
      }
    },
    "modern": {
      "name": "当代扎心",
      "description": "社交媒体感的当代表达",
      "template": "{userMeaning}",
      "visual": {
        "font": "modern",
        "color": "#1a1a1a",
        "layout": "horizontal"
      }
    },
    "minimal": {
      "name": "极简哲学",
      "description": "极简高级的哲学表达",
      "template": "{comp1} · {comp2} · {keyword}\n{philosophy}",
      "visual": {
        "font": "minimal",
        "color": "#333333",
        "layout": "centered"
      }
    }
  },
  "personalities": [
    {
      "id": "huiyi_mage",
      "name": "会意魔法师",
      "description": "擅长把两个已有意义组合起来",
      "match": {
        "structure": [
          "left_right",
          "top_bottom"
        ],
        "minComponents": 2
      }
    },
    {
      "id": "xiangxing_observer",
      "name": "象形观察家",
      "description": "擅长从现实世界寻找造字灵感",
      "match": {
        "category": [
          "nature"
        ],
        "singleComponent": true
      }
    },
    {
      "id": "structure_designer",
      "name": "构形设计师",
      "description": "对字形比例和结构特别敏感",
      "match": {
        "usesCustomLayout": true
      }
    },
    {
      "id": "emotion_crafter",
      "name": "情绪造字师",
      "description": "擅长把难以描述的情绪变成文字",
      "match": {
        "hasHeart": true,
        "style": "modern"
      }
    }
  ],
